{
  "title": "AI-BankApp-DevOps Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Backend HTTP Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"ai-bankapp-backend\"}[5m])) by (uri)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend JVM Memory Used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"ai-bankapp-backend\", area=\"heap\"}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI Fraud Service Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"ai-fraud-service\"}[5m])) by (handler)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend P95 Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"ai-bankapp-backend\"}[5m])) by (le))" }
      ]
    }
  ]
}
